# =============================================================================
# Thread N Form — backend env template
# Copy to `.env` for local, or paste into Vercel → Project → Settings → Environment
# Variables (Production + Preview). Root Directory must be `src/backend`.
# =============================================================================

# --- Server ---
PORT=3000
API_PREFIX=api/v1

# Storefront URL (auth redirects + auto-added to CORS)
# Local:  http://localhost:3001
# Prod:   https://thread-nform-txkk.vercel.app
FRONTEND_URL=http://localhost:3001

# Comma-separated allowed browser origins (no trailing slash)
# Must include the live storefront or browsers will block API calls.
# Local example:
#   http://localhost:3001,http://localhost:5173,http://localhost:3000
# Production example (set this on Vercel):
#   https://thread-nform-txkk.vercel.app
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000,https://thread-nform-txkk.vercel.app

# Long random string — guest cart HMAC (rotate in production)
# Required in production (min 32 chars), e.g. `openssl rand -hex 32`.
CART_TOKEN_SECRET=change-me-to-a-random-64-char-hex-string

IDEMPOTENCY_TTL_HOURS=24
MAX_UPLOAD_BYTES=52428800
DEFAULT_CURRENCY=GBP
DEFAULT_COUNTRY=GB

# --- Supabase Auth / API (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy JWT keys (optional if the keys above are set)
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Database (Dashboard → Database → Connect → Session pooler URI) ---
# Prefer pooler (IPv4). Required on Vercel or the function crashes on boot.
# Example:
#   postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# On Vercel prefer the transaction pooler (port 6543): session mode (5432)
# allows only 15 clients in total across every warm function instance.
# Max connections per instance (default 2 on Vercel, 10 elsewhere).
# DATABASE_POOL_MAX=
SUPABASE_DB_REGION=ap-south-1

# --- Storage buckets ---
SUPABASE_STORAGE_BUCKET=products
SUPABASE_STORAGE_BUCKET_PRODUCTS=products
SUPABASE_STORAGE_BUCKET_PAYMENT_PROOFS=payment-proofs

# --- Admin bootstrap (local scripts only; not required on Vercel runtime) ---
OWNER_EMAIL=owner@fareya.local

# --- Scheduled housekeeping (Vercel Cron) ---
# Bearer secret for GET /api/v1/cron/release-expired-holds (releases idle cart
# stock holds and cancels unpaid orders past payments.autoExpirePendingHours).
# Vercel sends it automatically when CRON_SECRET is set on the project.
CRON_SECRET=

# --- Rate limiting ---
# Limits are per route, stored in Postgres (migration 012) so they hold across
# serverless instances. Leave enabled; `false` exists only for test runs.
# RATE_LIMIT_ENABLED=true

# --- Optional SMTP (empty = log notifications only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thread N Form <noreply@threadnform.com>

# =============================================================================
# Vercel Production checklist (backend project → thread-nform.vercel.app)
# Paste these keys with real values; leave PORT unset on Vercel.
#
#   API_PREFIX=api/v1
#   FRONTEND_URL=https://thread-nform-txkk.vercel.app
#   CORS_ORIGINS=https://thread-nform-txkk.vercel.app
#   CART_TOKEN_SECRET=<long-random, 32+ chars — the API refuses to boot without it>
#   CRON_SECRET=<long-random>
#   IDEMPOTENCY_TTL_HOURS=24
#   MAX_UPLOAD_BYTES=52428800
#   DEFAULT_CURRENCY=GBP
#   DEFAULT_COUNTRY=GB
#   SUPABASE_URL=https://….supabase.co
#   SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
#   SUPABASE_SECRET_KEY=sb_secret_…
#   SUPABASE_JWKS_URL=https://….supabase.co/auth/v1/.well-known/jwks.json
#   DATABASE_URL=postgresql://…pooler.supabase.com:5432/postgres
#   SUPABASE_STORAGE_BUCKET=products
#   SUPABASE_STORAGE_BUCKET_PRODUCTS=products
#   SUPABASE_STORAGE_BUCKET_PAYMENT_PROOFS=payment-proofs
#   SMTP_FROM=Thread N Form <noreply@threadnform.com>
#
# After deploy, verify:
#   curl -s https://thread-nform.vercel.app/api/v1/health
# =============================================================================
