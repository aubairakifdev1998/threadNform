# Server
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000
CART_TOKEN_SECRET=change-me-in-production
IDEMPOTENCY_TTL_HOURS=24
MAX_UPLOAD_BYTES=52428800
DEFAULT_CURRENCY=GBP
DEFAULT_COUNTRY=GB

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Database (Dashboard → Project Settings → Database → Connection string URI)
# Required for: npm run db:migrate
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Legacy aliases (optional if the new keys above are set)
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage buckets
SUPABASE_STORAGE_BUCKET=products
SUPABASE_STORAGE_BUCKET_PRODUCTS=products
SUPABASE_STORAGE_BUCKET_PAYMENT_PROOFS=payment-proofs

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Optional SMTP (empty = log notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thread N Form <noreply@threadnform.com>
